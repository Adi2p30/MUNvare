# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional fallback
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Optional fallback

# Ollama Configuration
# Ollama is used for quick/simple tasks (chat, chits, summaries)
# Gemini is used for complex tasks (speeches, research, analysis)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# Note: Make sure Ollama is installed and running locally
# Install: https://ollama.ai
# Pull model: ollama pull gemma3:1b
# Start server: ollama serve
