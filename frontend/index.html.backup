<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MUNvare - Complete MUN Assistant</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Sidebar Navigation -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <h1>MUNvare</h1>
            <p class="subtitle">Your MUN Companion</p>
        </div>
        <ul class="nav-items">
            <li><a href="#" data-section="dashboard" class="nav-link active">Dashboard</a></li>
            <li><a href="#" data-section="chat" class="nav-link">AI Chat</a></li>
            <li><a href="#" data-section="speeches" class="nav-link">Speech Generator</a></li>
            <li><a href="#" data-section="notes" class="nav-link">My Notes</a></li>
            <li><a href="#" data-section="premade" class="nav-link">Study Guides</a></li>
            <li><a href="#" data-section="research" class="nav-link">Research Tools</a></li>
            <li><a href="#" data-section="speech-rating" class="nav-link">Speech Rating</a></li>
            <li><a href="#" data-section="search" class="nav-link">Search Book</a></li>
        </ul>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">

        <!-- Dashboard Section -->
        <section id="dashboard" class="content-section active">
            <h2>Dashboard</h2>
            <div class="dashboard-grid">
                <div class="dashboard-card" onclick="navigateTo('chat')">
                    <h3>AI Chat Assistant</h3>
                    <p>Ask questions about MUN procedures, get advice, and generate content</p>
                </div>
                <div class="dashboard-card" onclick="navigateTo('speeches')">
                    <h3>Speech Generator</h3>
                    <p>Generate professional MUN speeches based on your country and topic</p>
                </div>
                <div class="dashboard-card" onclick="navigateTo('notes')">
                    <h3>Note Taking</h3>
                    <p>Create and organize your research with AI-powered analysis</p>
                </div>
                <div class="dashboard-card" onclick="navigateTo('premade')">
                    <h3>Study Guides</h3>
                    <p>Pre-made comprehensive notes from the MUN guidebook</p>
                </div>
                <div class="dashboard-card" onclick="navigateTo('research')">
                    <h3>Research Tools</h3>
                    <p>POI questions, foreign policy research, and modcaucus topics</p>
                </div>
                <div class="dashboard-card" onclick="navigateTo('speech-rating')">
                    <h3>Speech Rating</h3>
                    <p>Record and analyze your speeches with AI feedback</p>
                </div>
            </div>
        </section>

        <!-- Chat Section -->
        <section id="chat" class="content-section">
            <h2>AI Chat Assistant</h2>
            <div class="chat-container">
                <div class="chat-messages" id="chatMessages"></div>
                <div class="chat-input-container">
                    <input type="text" id="chatInput" placeholder="Ask anything about MUN..." />
                    <button onclick="sendMessage()" class="btn">Send</button>
                </div>
            </div>
        </section>

        <!-- Speech Generator Section -->
        <section id="speeches" class="content-section">
            <h2>Speech Generator</h2>
            <div class="form-container">
                <div class="form-group">
                    <label>Country</label>
                    <input type="text" id="speechCountry" placeholder="e.g., India, United States" />
                </div>
                <div class="form-group">
                    <label>Committee</label>
                    <input type="text" id="speechCommittee" placeholder="e.g., UNSC, ECOSOC, UNHRC" />
                </div>
                <div class="form-group">
                    <label>Topic/Agenda</label>
                    <input type="text" id="speechTopic" placeholder="e.g., Climate Change, Cybersecurity" />
                </div>
                <div class="form-group">
                    <label>Stance (Optional)</label>
                    <input type="text" id="speechStance" placeholder="e.g., Pro-regulation, Against intervention" />
                </div>
                <div class="form-group">
                    <label>Speech Type</label>
                    <select id="speechType">
                        <option value="GSL">GSL (General Speakers List)</option>
                        <option value="Moderated Caucus">Moderated Caucus</option>
                        <option value="Opening Speech">Opening Speech</option>
                        <option value="Closing Speech">Closing Speech</option>
                    </select>
                </div>
                <button onclick="generateSpeech()" class="btn btn-primary">Generate Speech</button>

                <div id="speechOutput" class="output-container" style="display: none;">
                    <h3>Generated Speech</h3>
                    <div id="speechContent" class="speech-content"></div>
                    <button onclick="copySpeech()" class="btn btn-secondary">Copy to Clipboard</button>
                </div>
            </div>

            <div class="saved-speeches">
                <h3>Saved Speeches</h3>
                <div id="savedSpeeches" class="speeches-list"></div>
            </div>
        </section>

        <!-- Notes Section -->
        <section id="notes" class="content-section">
            <div class="notes-header">
                <h2>My Notes</h2>
                <button onclick="createNewNote()" class="btn btn-primary">+ New Note</button>
            </div>

            <div class="notes-container">
                <div class="notes-list">
                    <div id="notesList"></div>
                </div>
                <div class="note-editor" id="noteEditor" style="display: none;">
                    <input type="text" id="noteTitle" class="note-title" placeholder="Note Title" />
                    <textarea id="noteContent" class="note-content" placeholder="Start writing your notes..."></textarea>
                    <div class="note-actions">
                        <button onclick="saveNote()" class="btn btn-primary">Save</button>
                        <button onclick="analyzeNote()" class="btn btn-secondary">Analyze with AI</button>
                        <button onclick="deleteNote()" class="btn btn-danger">Delete</button>
                    </div>
                    <div id="noteAnalysis" class="note-analysis" style="display: none;"></div>
                </div>
            </div>
        </section>

        <!-- Premade Notes Section -->
        <section id="premade" class="content-section">
            <h2>Study Guides</h2>
            <p class="section-description">Comprehensive notes extracted from the MUN guidebook</p>
            <div id="premadeNotesList" class="premade-notes-grid"></div>
            <div id="premadeNoteViewer" class="note-viewer" style="display: none;">
                <button onclick="closePremadeNote()" class="btn btn-secondary">← Back to List</button>
                <h3 id="premadeNoteTitle"></h3>
                <div id="premadeNoteContent" class="markdown-content"></div>
            </div>
        </section>

        <!-- Research Tools Section -->
        <section id="research" class="content-section">
            <h2>Research Tools</h2>

            <div class="research-tools">
                <!-- POI Generator -->
                <div class="tool-card">
                    <h3>POI Question Generator</h3>
                    <div class="form-group">
                        <label>Your Country</label>
                        <input type="text" id="poiCountry" placeholder="e.g., India" />
                    </div>
                    <div class="form-group">
                        <label>Topic</label>
                        <input type="text" id="poiTopic" placeholder="e.g., Climate Change" />
                    </div>
                    <div class="form-group">
                        <label>Target Country (Optional)</label>
                        <input type="text" id="poiTarget" placeholder="e.g., United States" />
                    </div>
                    <button onclick="generatePOI()" class="btn">Generate Questions</button>
                    <div id="poiOutput" class="output-container" style="display: none;"></div>
                </div>

                <!-- Foreign Policy Research -->
                <div class="tool-card">
                    <h3>Foreign Policy Research</h3>
                    <div class="form-group">
                        <label>Country</label>
                        <input type="text" id="fpCountry" placeholder="e.g., China" />
                    </div>
                    <div class="form-group">
                        <label>Topic</label>
                        <input type="text" id="fpTopic" placeholder="e.g., Nuclear Disarmament" />
                    </div>
                    <button onclick="researchForeignPolicy()" class="btn">Research</button>
                    <div id="fpOutput" class="output-container" style="display: none;"></div>
                </div>

                <!-- Moderated Caucus Topics -->
                <div class="tool-card">
                    <h3>Moderated Caucus Topics</h3>
                    <div class="form-group">
                        <label>Main Agenda</label>
                        <input type="text" id="mcAgenda" placeholder="e.g., Sustainable Development" />
                    </div>
                    <div class="form-group">
                        <label>Committee</label>
                        <input type="text" id="mcCommittee" placeholder="e.g., ECOSOC" />
                    </div>
                    <button onclick="suggestModCaucus()" class="btn">Get Suggestions</button>
                    <div id="mcOutput" class="output-container" style="display: none;"></div>
                </div>
            </div>
        </section>

        <!-- Speech Rating Section -->
        <section id="speech-rating" class="content-section">
            <h2>Speech Rating & Analysis</h2>
            <p class="section-description">Record your speech and get AI-powered feedback</p>

            <div class="speech-rating-container">
                <div class="recording-controls">
                    <button id="startRecording" onclick="startRecording()" class="btn btn-primary">Start Recording</button>
                    <button id="stopRecording" onclick="stopRecording()" class="btn btn-danger" style="display: none;">Stop Recording</button>
                    <div id="recordingStatus" class="recording-status"></div>
                </div>

                <div id="transcriptionOutput" class="output-container" style="display: none;">
                    <h3>Transcription</h3>
                    <div id="transcriptionText" class="transcription-text"></div>

                    <h3>Sentiment Analysis</h3>
                    <div id="sentimentAnalysis" class="sentiment-analysis"></div>

                    <h3>AI Feedback</h3>
                    <div id="speechFeedback" class="speech-feedback"></div>
                </div>
            </div>
        </section>

        <!-- Search Section -->
        <section id="search" class="content-section">
            <h2>Search MUN Guidebook</h2>
            <div class="search-container">
                <input type="text" id="searchQuery" placeholder="Search for MUN topics, procedures, tips..." />
                <button onclick="searchBook()" class="btn">Search</button>
            </div>
            <div id="searchResults" class="search-results"></div>
        </section>

    </main>

    <script src="app.js"></script>
</body>
</html>
